<?xml version="1.0" encoding="utf-8"?>
<!--
  YouTube Downloader installer.

  Installs for the current user, without asking for elevation. That is the
  reason the destination is %LOCALAPPDATA%\Programs rather than
  C:\Program Files: writing to Program Files requires administrator rights,
  with no exceptions — a Windows restriction, not an installer choice. Chrome,
  Discord and Spotify install in the same place for the same reason.

  The user chooses whether to get a Desktop shortcut; the Start Menu one is
  always created, since that is how Windows finds the program.

  Built by packaging/build.ps1, which passes AppDir, AppVersion and RepoRoot on
  the command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="YouTube Downloader"
           Manufacturer="Victor Medeiros"
           Version="$(AppVersion)"
           UpgradeCode="3F51138E-43FB-4277-9BEA-18C1BC16932B"
           Scope="perUser"
           Compressed="yes"
           Language="1033"
           Codepage="1252">

    <SummaryInformation Description="Download video and audio from YouTube and other sites"
                        Manufacturer="Victor Medeiros" />

    <!-- Installing a newer version removes the previous one on its own. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed on this computer." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="Installed OR VersionNT64"
            Message="[ProductName] requires a 64-bit version of Windows." />

    <!-- Details shown under Installed Apps. -->
    <Icon Id="AppIcon.exe" SourceFile="$(RepoRoot)\packaging\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/victorhuggomed2006-ux/YoutubeDownloader" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/victorhuggomed2006-ux/YoutubeDownloader" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      Do not set ALLUSERS or MSIINSTALLPERUSER here. Scope="perUser" already
      marks the package as UAC compliant, and in that case Windows Installer
      ignores those properties — the log says so literally: "MSIINSTALLPERUSER
      property is not valid for UAC compliant package". The scope comes from
      the package header.
    -->

    <!-- Ticked by default; the options screen lets the user clear it. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <!-- Check box on the final screen. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch YouTube Downloader" />

    <WixVariable Id="WixUILicenseRtf" Value="$(RepoRoot)\packaging\wix\license.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Runs the app when the installer closes, if the box is still ticked. -->
    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]YouTubeDownloader.exe"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <UI>
      <!--
        An extra screen between "choose the folder" and "confirm", holding just
        the shortcut choice. The WixUI dialogs have nowhere to fit it, and the
        feature tree would show installer jargon to someone who only wants a
        shortcut.
      -->
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName]">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="Choose where the program should appear." />

        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="26" Y="70" Width="310" Height="18"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="Create a Desktop shortcut" />

        <Control Id="Explanation" Type="Text" X="26" Y="96" Width="310" Height="40"
                 NoPrefix="yes"
                 Text="The Start Menu shortcut is always created. The program installs into your user folder and will not ask for administrator permission." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!--
        Slot the new screen into the sequence. Orders higher than WixUI's own
        win over the default rules, which would go straight from InstallDirDlg
        to VerifyReadyDlg.
      -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="10" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!--
      %LOCALAPPDATA%\Programs is where Windows expects single-user programs.
      Installing into Program Files would force elevation.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="YouTube Downloader" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="YouTube Downloader" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainApplication"
             Title="YouTube Downloader"
             Description="The application, the download engine and FFmpeg."
             Level="1"
             AllowAbsent="no">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

  </Package>

  <!-- Every file PyInstaller produced, subfolders included. -->
  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AppDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcutComponent"
               Directory="AppMenuFolder"
               Guid="7D6AFE7A-A7BB-4CD4-960F-8FA4D5ECC8CE">
      <Shortcut Id="StartMenuShortcut"
                Name="YouTube Downloader"
                Description="Download video and audio from YouTube and other sites"
                Target="[INSTALLFOLDER]YouTubeDownloader.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />

      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />

      <!-- MSI requires a key path for the shortcut component. -->
      <RegistryValue Root="HKCU"
                     Key="Software\Victor Medeiros\YouTube Downloader"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <!-- Only installed when the options screen check box stays ticked. -->
    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder"
               Guid="1B0E4A4C-9F2D-4F4E-8C7A-3D5B6E8F1A20"
               Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut"
                Name="YouTube Downloader"
                Description="Download video and audio from YouTube and other sites"
                Target="[INSTALLFOLDER]YouTubeDownloader.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />

      <RegistryValue Root="HKCU"
                     Key="Software\Victor Medeiros\YouTube Downloader"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
