# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{md,markdown}]
# Duas linhas em branco no fim marcam quebra de linha no Markdown.
trim_trailing_whitespace = false

[*.ps1]
# O PowerShell no Windows espera CRLF.
end_of_line = crlf

[*.{wxs,xml,ts}]
indent_size = 2

[Makefile]
indent_style = tab
